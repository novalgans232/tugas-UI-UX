        }
        .intro-box {
            display: flex;
            align-items: center;
            gap: 15px;
            background-color: #f1f1f1;
            padding: 15px;
            border-radius: 5px;
        }
        .grid-anggota {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            padding: 20px;
        }
        article {
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            display: flex;
            gap: 15px;
            background-color: #fafafa;
        }
        figure {
            margin: 0;
            width: 120px;
            height: 150px;
            background-color: #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
            border: 1px dashed #aaa;
        }
        figure img {
            max-width: 100%;
            height: auto;
        }
        .info-anggota {
            flex: 1;
        }
        .info-anggota h3 {
            margin-top: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .role {
            font-size: 12px;
            background-color: #ccc;
            padding: 3px 8px;
            border-radius: 12px;
        }
        table {
            width: 100%;
            font-size: 14px;
            margin-bottom: 10px;
        }
        table td {
            padding: 3px 0;
        }
        .desc {
            font-size: 12px;
            color: #666;
            line-height: 1.4;
        }
        footer {
            text-align: center;
            padding: 15px;
            background-color: #e9e9e9;
            border-top: 1px solid #ccc;
            font-size: 14px;
        }
