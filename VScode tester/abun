        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1000px;
            margin: auto;
            background-color: #fff;
            border: 1px solid #ccc;
        }
        header {
            text-align: center;
            padding: 20px;
            background-color: #e9e9e9;
            border-bottom: 1px solid #ccc;
        }
        header h1 {
            margin: 0 0 5px 0;
